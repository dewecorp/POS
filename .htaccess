DirectoryIndex index.php
Options -Indexes
DirectorySlash Off
RewriteEngine On
RewriteBase /POS/

# ---------------------------------------------------------
#  Pretty URL (sembunyikan index.php & ekstensi .php)
#  Bila mod_rewrite tidak tersedia, aplikasi tetap jalan
#  memakai URL .php biasa (lihat PRETTY_URL di config/app.php)
# ---------------------------------------------------------

# Redirect akses langsung /index.php atau /foo/index.php -> /foo (GET saja)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+POS/([^\s?]*?)/?index\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Redirect akses langsung /foo.php -> /foo (GET saja, kecuali api & uploads)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{REQUEST_URI} !^/POS/(api|uploads)/
RewriteCond %{THE_REQUEST} \s/+POS/([^\s?]+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Lewati file yang benar-benar ada
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# /foo/bar -> /foo/bar.php
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# /foo -> /foo/index.php
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^(.+?)/?$ $1/index.php [L]

<FilesMatch "\.(php|phtml)$">
  Header set X-Content-Type-Options nosniff
</FilesMatch>
Header set X-Frame-Options SAMEORIGIN
Header set Referrer-Policy strict-origin-when-cross-origin
Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header set Pragma "no-cache"

<FilesMatch "^(config|database|\.env)">
  Require all denied
</FilesMatch>
